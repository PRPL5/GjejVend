# Supabase Postgres via the Supavisor session pooler (IPv4). Copy to backend/.env and fill in the password.
# Keep the value in single quotes so characters like # are not treated as comments.
ConnectionStrings__Default='Host=aws-1-eu-west-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require;Maximum Pool Size=10'

# Supabase project URL. The API validates Supabase Auth JWTs against its public signing keys.
Supabase__Url=https://<project-ref>.supabase.co

# Background job that completes overdue active bookings and marks unattended confirmed ones as no_show, every minute.
# Set to false to keep a local run from changing bookings in the database it points at.
Bookings__CloseOverdue=true
